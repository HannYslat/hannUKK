# ====================================================
# MIKROTIK BASIC CONFIGURATION + VLAN + DHCP + INTERNET
# UKK TKJ 2026/2027
# ====================================================

# 1. SETTING ROUTER IDENTITY
/system identity set name="Mikrotik-Raihan"

# 2. RENAMING INTERFACES
/interface set [find default-name=ether1] name="ether1-INET"
/interface set [find default-name=ether2] name="ether2-LAN"

# 3. VLAN CONFIGURATION
/interface vlan
add name=Guru_Admin vlan-id=10 interface=ether2-LAN
add name=Siswa vlan-id=20 interface=ether2-LAN
add name=Server vlan-id=30 interface=ether2-LAN

# 4. IP ADDRESS GATEWAY
/ip address
add address=192.168.10.1/24 interface=VLAN10-Guru_Admin
add address=192.168.20.1/24 interface=VLAN20-Siswa
add address=10.10.10.1/24 interface=VLAN30-Server

# 5. DHCP CLIENT WAN
/ip dhcp-client
add interface=ether1-INET disabled=no add-default-route=yes use-peer-dns=yes use-peer-ntp=yes

# 6. DNS CONFIGURATION
/ip dns
set servers=8.8.8.8,8.8.4.4 allow-remote-requests=yes

# 7. DHCP POOL
/ip pool
add name=pool-vlan10 ranges=192.168.10.2-192.168.10.254
add name=pool-vlan20 ranges=192.168.20.2-192.168.20.254
add name=pool-vlan30 ranges=10.10.10.2-10.10.10.254

# 8. DHCP SERVER VLAN 10, 20, 30
/ip dhcp-server
add name=dhcp-vlan10 interface=VLAN10-Guru_Admin address-pool=pool-vlan10 disabled=no
add name=dhcp-vlan20 interface=VLAN20-Siswa address-pool=pool-vlan20 disabled=no
add name=dhcp-vlan30 interface=VLAN30-Server address-pool=pool-vlan30 disabled=no

# 9. DHCP NETWORK
/ip dhcp-server network
add address=192.168.10.0/24 gateway=192.168.10.1 dns-server=8.8.8.8,8.8.4.4
add address=192.168.20.0/24 gateway=192.168.20.1 dns-server=8.8.8.8,8.8.4.4
add address=10.10.10.0/24 gateway=10.10.10.1 dns-server=8.8.8.8,8.8.4.4

# 10. FIREWALL NAT
/ip firewall nat
add chain=srcnat out-interface=ether1-INET action=masquerade

# ====================================================
# END OF CONFIGURATION
# ====================================================
